{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "config/index.ts",
        "config/vars.ts",
        "contract.ts",
        "featureFlag.ts",
        "featureSubgraph.ts",
        "federatedGraph.ts",
        "getClients.ts",
        "getContract.ts",
        "getFeatureFlag.ts",
        "getFeatureSubgraph.ts",
        "getFederatedGraph.ts",
        "getMonograph.ts",
        "getNamespace.ts",
        "getPersistedOperations.ts",
        "getSubgraph.ts",
        "index.ts",
        "monograph.ts",
        "namespace.ts",
        "persistedOperations.ts",
        "provider.ts",
        "routerToken.ts",
        "subgraph.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts"
    ]
}
